DATABASE_URL=sqlite:///./runtime/studio.db
TRAINING_MODE=demo
ALLOWED_ORIGINS=http://127.0.0.1:8010,http://localhost:8010,http://localhost:5173,http://127.0.0.1:5173
COOKIE_SECURE=false
AI_PROVIDER=disabled
# Asset scanning is local-only and fail-closed. Never enable without approval.
ASSET_SCAN_APPROVED=false
ASSET_SCAN_APPROVAL_REF=
CLAMD_PORT=3310
# Standalone offline worker only. The HTTP server never runs a converter.
IFC_CONVERSION_APPROVED=false
IFC_CONVERSION_APPROVAL_REF=
IFC_OFFLINE_HOST_CONFIRMED=false
IFC_TOOL_MANIFEST=
IFC_TOOL_MANIFEST_SHA256=
# Bounded video processing stays off until approved tools/host and AV are verified.
MEDIA_PROCESSING_APPROVED=false
MEDIA_PROCESSING_APPROVAL_REF=
MEDIA_HOST_ISOLATION_CONFIRMED=false
MEDIA_TOOL_MANIFEST=
MEDIA_TOOL_MANIFEST_SHA256=
# Public data keys stay on the server. Never use VITE_ variables for these.
EXTERNAL_DATA_APPROVED=false
EXTERNAL_DATA_APPROVAL_REF=
DATA_GOV_BUILDING_KEY=
KMA_SERVICE_KEY=
DATA_GOV_HYDRANT_KEY=
# Approved ODcloud dataset path only, e.g. /api/<8 digits>/v1/<UUID>.
HYDRANT_DATASET_PATH=
# Matching official catalogue URL, verified by the administrator.
HYDRANT_CATALOG_URL=
KAKAO_JAVASCRIPT_KEY=
VITE_KAKAO_MAPS_APPROVED=false
# Only a public, domain-restricted Kakao JavaScript key belongs in VITE_ variables.
VITE_KAKAO_JAVASCRIPT_KEY=
# Production: use postgresql+psycopg2://... and TRAINING_MODE=production.
# Set bootstrap account through scripts/manage.py; never commit credentials.
