        },
        "warnings": {
          "items": {
            "type": "string"
          },
          "maxItems": 30,
          "title": "Warnings",
          "type": "array"
        }
      },
      "required": [
        "id",
        "import_id",
        "provider",
        "source",
        "retrieved_at",
        "raw_sha256",
        "records"
      ],
      "title": "ExternalLayer",
      "type": "object"
    },
    "ExternalReview": {
      "additionalProperties": false,
      "properties": {
        "import_id": {
          "title": "Import Id",
          "type": "string"
        },
        "layer_id": {
          "title": "Layer Id",
          "type": "string"
        },
        "actor_id": {
          "title": "Actor Id",
          "type": "string"
        },
        "at": {
          "title": "At",
          "type": "string"
        },
        "note": {
          "maxLength": 1000,
          "minLength": 3,
          "title": "Note",
          "type": "string"
        },
        "selected_ids": {
          "items": {
            "type": "string"
          },
          "maxItems": 100,
          "minItems": 1,
          "title": "Selected Ids",
          "type": "array"
        },
        "applied_fields": {
          "items": {
            "type": "string"
          },
          "maxItems": 10,
          "title": "Applied Fields",
          "type": "array"
        },
        "supersedes_import_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Supersedes Import Id"
        }
      },
      "required": [
        "import_id",
        "layer_id",
        "actor_id",
        "at",
        "note",
        "selected_ids"
      ],
      "title": "ExternalReview",
      "type": "object"
    },
    "Feature": {
      "additionalProperties": false,
