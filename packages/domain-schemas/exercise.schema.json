{
  "$defs": {
    "AssetBinding": {
      "additionalProperties": false,
      "properties": {
        "building_id": {
          "pattern": "^B[0-9]{2,4}$",
          "title": "Building Id",
          "type": "string"
        },
        "purpose": {
          "enum": [
            "MODEL",
            "FACADE",
            "REFERENCE",
            "VIDEO"
          ],
          "title": "Purpose",
          "type": "string"
        },
        "visibility": {
          "default": "STAFF",
          "enum": [
            "PUBLIC",
            "STAFF"
          ],
          "title": "Visibility",
          "type": "string"
        },
        "photo_face": {
          "default": "NORTH",
          "enum": [
            "NORTH",
            "SOUTH",
            "EAST",
            "WEST"
          ],
          "title": "Photo Face",
          "type": "string"
        },
        "unit_scale": {
          "default": 1,
          "maximum": 1000,
          "minimum": 0.001,
          "title": "Unit Scale",
          "type": "number"
        },
        "rotation_y": {
          "default": 0,
          "maximum": 360,
          "minimum": -360,
          "title": "Rotation Y",
          "type": "number"
        },
        "offset": {
          "items": {
            "type": "number"
          },
          "maxItems": 3,
          "minItems": 3,
          "title": "Offset",
          "type": "array"
        },
        "floor_map": {
          "additionalProperties": {
            "type": "integer"
          },
          "maxProperties": 2000,
          "title": "Floor Map",
          "type": "object"
        },
        "object_map": {
          "additionalProperties": {
            "type": "string"
          },
          "maxProperties": 2000,
          "title": "Object Map",
          "type": "object"
        },
        "id": {
          "pattern": "^binding-[a-f0-9]{32}$",
          "title": "Id",
          "type": "string"
        },
        "asset_id": {
          "pattern": "^asset-[a-f0-9]{32}$",
          "title": "Asset Id",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "kind": {
          "enum": [
            "GLB",
            "PHOTO",
            "VIDEO"
          ],
          "title": "Kind",
          "type": "string"
        },
        "mime": {
          "enum": [
            "model/gltf-binary",
            "image/png",
            "video/webm"
          ],
          "title": "Mime",
          "type": "string"
        },
        "label": {
          "maxLength": 160,
          "minLength": 1,
          "title": "Label",
          "type": "string"
        },
        "source": {
          "$ref": "#/$defs/Source"
        },
        "manifest": {
          "$ref": "#/$defs/AssetManifest"
        },
        "reviewed_at": {
          "title": "Reviewed At",
          "type": "string"
        }
      },
      "required": [
        "building_id",
        "purpose",
        "id",
        "asset_id",
        "sha256",
        "kind",
        "mime",
        "label",
        "source",
        "manifest",
        "reviewed_at"
      ],
      "title": "AssetBinding",
      "type": "object"
    },
    "AssetManifest": {
      "additionalProperties": false,
      "properties": {
        "bounds": {
          "items": {
            "items": {
              "type": "number"
            },
            "type": "array"
          },
          "maxItems": 2,
          "title": "Bounds",
          "type": "array"
        },
        "nodes": {
          "items": {
            "$ref": "#/$defs/AssetNode"
          },
          "maxItems": 2000,
          "title": "Nodes",
          "type": "array"
        },
        "triangles": {
          "default": 0,
          "maximum": 200000,
          "minimum": 0,
          "title": "Triangles",
          "type": "integer"
        },
        "texture_pixels": {
          "default": 0,
          "maximum": 8388608,
          "minimum": 0,
          "title": "Texture Pixels",
          "type": "integer"
        },
        "width": {
          "default": 0,
          "maximum": 4096,
          "minimum": 0,
          "title": "Width",
          "type": "integer"
        },
        "height": {
          "default": 0,
          "maximum": 4096,
          "minimum": 0,
          "title": "Height",
          "type": "integer"
        },
        "copyright_notice": {
          "default": "",
          "maxLength": 500,
          "title": "Copyright Notice",
          "type": "string"
        },
        "duration_seconds": {
          "default": 0,
          "maximum": 181,
          "minimum": 0,
          "title": "Duration Seconds",
          "type": "number"
        },
        "frame_rate": {
          "default": 0,
          "maximum": 60,
          "minimum": 0,
          "title": "Frame Rate",
          "type": "number"
        },
        "has_audio": {
          "default": false,
          "title": "Has Audio",
          "type": "boolean"
        },
        "video_codec": {
          "default": "",
          "maxLength": 40,
          "title": "Video Codec",
          "type": "string"
        },
        "processing_tool": {
          "default": "",
          "maxLength": 150,
          "title": "Processing Tool",
          "type": "string"
        },
        "processing_manifest_sha256": {
          "default": "",
          "pattern": "^(?:[a-f0-9]{64})?$",
          "title": "Processing Manifest Sha256",
          "type": "string"
        }
      },
      "title": "AssetManifest",
      "type": "object"
    },
    "AssetMapping": {
      "additionalProperties": false,
      "properties": {
        "building_id": {
          "pattern": "^B[0-9]{2,4}$",
          "title": "Building Id",
          "type": "string"
        },
        "purpose": {
          "enum": [
            "MODEL",
            "FACADE",
            "REFERENCE",
            "VIDEO"
          ],
          "title": "Purpose",
          "type": "string"
        },
        "visibility": {
          "default": "STAFF",
          "enum": [
            "PUBLIC",
            "STAFF"
          ],
          "title": "Visibility",
          "type": "string"
        },
        "photo_face": {
          "default": "NORTH",
          "enum": [
            "NORTH",
            "SOUTH",
            "EAST",
            "WEST"
          ],
          "title": "Photo Face",
          "type": "string"
        },
        "unit_scale": {
          "default": 1,
          "maximum": 1000,
          "minimum": 0.001,
          "title": "Unit Scale",
          "type": "number"
        },
        "rotation_y": {
          "default": 0,
          "maximum": 360,
          "minimum": -360,
          "title": "Rotation Y",
          "type": "number"
        },
        "offset": {
          "items": {
            "type": "number"
          },
          "maxItems": 3,
          "minItems": 3,
          "title": "Offset",
          "type": "array"
        },
        "floor_map": {
          "additionalProperties": {
            "type": "integer"
          },
          "maxProperties": 2000,
          "title": "Floor Map",
          "type": "object"
        },
        "object_map": {
          "additionalProperties": {
            "type": "string"
          },
          "maxProperties": 2000,
          "title": "Object Map",
          "type": "object"
        }
      },
      "required": [
        "building_id",
        "purpose"
      ],
      "title": "AssetMapping",
      "type": "object"
    },
    "AssetNode": {
      "additionalProperties": false,
      "properties": {
        "index": {
          "maximum": 1999,
          "minimum": 0,
          "title": "Index",
          "type": "integer"
        },
        "name": {
          "maxLength": 200,
          "title": "Name",
          "type": "string"
        },
        "bounds": {
          "items": {
            "items": {
              "type": "number"
            },
            "type": "array"
          },
          "maxItems": 2,
          "minItems": 2,
          "title": "Bounds",
          "type": "array"
        }
      },
      "required": [
        "index",
        "name",
        "bounds"
      ],
      "title": "AssetNode",
      "type": "object"
    },
    "AssetReview": {
      "additionalProperties": false,
      "properties": {
        "asset_id": {
          "title": "Asset Id",
          "type": "string"
        },
        "binding_id": {
          "title": "Binding Id",
          "type": "string"
        },
        "actor_id": {
          "title": "Actor Id",
          "type": "string"
        },
        "at": {
          "title": "At",
          "type": "string"
        },
        "note": {
          "maxLength": 1000,
          "minLength": 3,
          "title": "Note",
          "type": "string"
        },
        "action": {
          "enum": [
            "ATTACH",
            "DETACH"
          ],
          "title": "Action",
          "type": "string"
        },
        "mapping": {
          "anyOf": [
            {
              "$ref": "#/$defs/AssetMapping"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "prior_mapping": {
          "anyOf": [
            {
              "$ref": "#/$defs/AssetMapping"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "supersedes_asset_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Supersedes Asset Id"
        }
      },
      "required": [
        "asset_id",
        "binding_id",
        "actor_id",
        "at",
        "note",
        "action"
      ],
      "title": "AssetReview",
      "type": "object"
    },
    "Assignment": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "role_id": {
          "title": "Role Id",
          "type": "string"
        },
        "person_id": {
          "title": "Person Id",
          "type": "string"
        },
        "effective_from": {
          "format": "date-time",
          "title": "Effective From",
          "type": "string"
        },
        "effective_to": {
          "format": "date-time",
          "title": "Effective To",
          "type": "string"
        },
        "shift_id": {
          "default": "A",
          "title": "Shift Id",
          "type": "string"
        },
        "status": {
          "default": "ACTIVE",
          "enum": [
            "ACTIVE",
            "PLANNED",
            "ENDED"
          ],
          "title": "Status",
          "type": "string"
        },
        "backups": {
          "items": {
            "type": "string"
          },
          "maxItems": 10,
          "title": "Backups",
          "type": "array"
        }
      },
      "required": [
        "id",
        "role_id",
        "person_id",
        "effective_from",
        "effective_to"
      ],
      "title": "Assignment",
      "type": "object"
    },
    "Building": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^B[0-9]{2,4}$",
          "title": "Id",
          "type": "string"
        },
        "name": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "use": {
          "default": "창고",
          "title": "Use",
          "type": "string"
        },
        "floors": {
          "default": 3,
          "maximum": 80,
          "minimum": 1,
          "title": "Floors",
          "type": "integer"
        },
        "floor_height": {
          "default": 4,
          "maximum": 10,
          "minimum": 2,
          "title": "Floor Height",
          "type": "number"
        },
        "width": {
          "default": 32,
          "maximum": 300,
          "minimum": 3,
          "title": "Width",
          "type": "number"
        },
        "depth": {
          "default": 22,
          "maximum": 300,
          "minimum": 3,
          "title": "Depth",
          "type": "number"
        },
        "x": {
          "default": 0,
          "maximum": 2000,
          "minimum": -2000,
          "title": "X",
          "type": "number"
        },
        "z": {
          "default": 0,
          "maximum": 2000,
          "minimum": -2000,
          "title": "Z",
          "type": "number"
        },
        "rotation": {
          "default": 0,
          "maximum": 360,
          "minimum": -360,
          "title": "Rotation",
          "type": "number"
        },
        "color": {
          "default": "#b3bdc4",
          "pattern": "^#[0-9a-fA-F]{6}$",
          "title": "Color",
          "type": "string"
        },
        "entrances": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Entrances",
          "type": "array"
        },
        "footprint": {
          "items": {
            "items": {
              "type": "number"
            },
            "type": "array"
          },
          "maxItems": 100,
          "title": "Footprint",
          "type": "array"
        },
        "accuracy": {
          "default": "SIMULATED",
          "enum": [
            "SIMULATED",
            "APPROXIMATE",
            "VERIFIED"
          ],
          "title": "Accuracy",
          "type": "string"
        },
        "basement_floors": {
          "default": 0,
          "maximum": 20,
          "minimum": 0,
          "title": "Basement Floors",
          "type": "integer"
        },
        "roof_style": {
          "default": "FLAT",
          "enum": [
            "FLAT",
            "GABLE",
            "SHED"
          ],
          "title": "Roof Style",
          "type": "string"
        },
        "window_style": {
          "default": "REGULAR",
          "enum": [
            "REGULAR",
            "NONE"
          ],
          "title": "Window Style",
          "type": "string"
        },
        "wall_finish": {
          "default": "CONCRETE",
          "enum": [
            "CONCRETE",
            "BRICK",
            "METAL",
            "GLASS"
          ],
          "title": "Wall Finish",
          "type": "string"
        },
        "floor_outlines": {
          "items": {
            "$ref": "#/$defs/FloorOutline"
          },
          "maxItems": 100,
          "title": "Floor Outlines",
          "type": "array"
        }
      },
      "required": [
        "id",
        "name"
      ],
      "title": "Building",
      "type": "object"
    },
    "EventDefinition": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[A-Za-z0-9_-]{1,64}$",
          "title": "Id",
          "type": "string"
        },
        "title": {
          "maxLength": 160,
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "kind": {
          "default": "INJECT",
          "maxLength": 80,
          "title": "Kind",
          "type": "string"
        },
        "category": {
          "default": "화재",
          "maxLength": 80,
          "title": "Category",
          "type": "string"
        },
        "objective": {
          "maxLength": 300,
          "minLength": 1,
          "title": "Objective",
          "type": "string"
        },
        "sender": {
          "default": "모의 119상황실",
          "maxLength": 120,
          "title": "Sender",
          "type": "string"
        },
        "recipient_role_ids": {
          "items": {
            "type": "string"
          },
          "maxItems": 100,
          "minItems": 1,
          "title": "Recipient Role Ids",
          "type": "array"
        },
        "visibility": {
          "default": "PUBLIC",
          "enum": [
            "PUBLIC",
            "PRIVATE"
          ],
          "title": "Visibility",
          "type": "string"
        },
        "priority": {
          "default": "NORMAL",
          "enum": [
            "NORMAL",
            "HIGH",
            "CRITICAL"
          ],
          "title": "Priority",
          "type": "string"
        },
        "channel": {
          "default": "RADIO_SIM",
          "enum": [
            "RADIO_SIM",
            "PHONE_SIM",
            "MESSENGER_SIM",
            "OBSERVATION",
            "VIDEO"
          ],
          "title": "Channel",
          "type": "string"
        },
        "truth_status": {
          "default": "UNCONFIRMED",
          "enum": [
            "CONFIRMED",
            "UNCONFIRMED",
            "FALSE_REPORT"
          ],
          "title": "Truth Status",
          "type": "string"
        },
        "text": {
          "maxLength": 5000,
          "minLength": 1,
          "title": "Text",
          "type": "string"
        },
        "expected_actions": {
          "default": "담당 임무에 맞는 확인·보고·협조를 관찰한다.",
          "maxLength": 3000,
          "title": "Expected Actions",
          "type": "string"
        },
        "trigger": {
          "$ref": "#/$defs/Trigger"
        },
        "patches": {
          "items": {
            "$ref": "#/$defs/Patch"
          },
          "maxItems": 100,
          "title": "Patches",
          "type": "array"
        },
        "media_cues": {
          "items": {
            "$ref": "#/$defs/MediaCue"
          },
          "maxItems": 10,
          "title": "Media Cues",
          "type": "array"
        },
        "next_event_ids": {
          "items": {
            "type": "string"
          },
          "maxItems": 100,
          "title": "Next Event Ids",
          "type": "array"
        },
        "terminal": {
          "default": false,
          "title": "Terminal",
          "type": "boolean"
        },
        "simulated_at": {
          "default": 0,
          "maximum": 86400,
          "minimum": 0,
          "title": "Simulated At",
          "type": "integer"
        },
        "evaluation_links": {
          "items": {
            "type": "string"
          },
          "title": "Evaluation Links",
          "type": "array"
        }
      },
      "required": [
        "id",
        "title",
        "objective",
        "recipient_role_ids",
        "text"
      ],
      "title": "EventDefinition",
      "type": "object"
    },
