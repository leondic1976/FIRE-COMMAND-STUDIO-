              {
                "type": "integer"
              },
              {
                "type": "number"
              },
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ]
          },
          "title": "Fields",
          "type": "object"
        }
      },
      "required": [
        "external_id",
        "name",
        "fields"
      ],
      "title": "ExternalFact",
      "type": "object"
    },
    "ExternalLayer": {
      "additionalProperties": false,
